# Required: create this key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional but recommended: set the same value in Netlify and in the app sidebar.
# When this is set, /api/generate rejects requests without the token.
APP_ACCESS_TOKEN=change-this-to-a-private-passphrase

# Browser origins allowed to call the API. Keep your production Netlify URL here.
ALLOWED_ORIGINS=https://xunpanhuifu.netlify.app,http://localhost:3000,http://localhost:8888

# Optional model overrides. DeepSeek says deepseek-chat/deepseek-reasoner are deprecated after 2026-07-24 15:59 UTC.
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# Local Express dev server port.
PORT=3000
